#include <stdio.h>
#include <string.h>

#define MAX 100

int stack[MAX];
int top = -1;

void push(int val) {
    stack[++top] = val;
}

int pop() {
    return stack[top--];
}

int applyOp(int a, int b, char op) {
    switch (op) {
        case '+': return a + b;
        case '-': return a - b;
        case '*': return a * b;
        case '/': return a / b;
    }
    return 0;
}

int evaluatePrefix(char *exp) {
    int length = strlen(exp);

    for (int i = length - 1; i >= 0; i--) {
        if (exp[i] == ' ' || exp[i] == '\n' || exp[i] == '\r') {
            continue;
        }

        if (exp[i] >= '0' && exp[i] <= '9') {
            int val = 0;
            int base = 1;
            while (i >= 0 && (exp[i] >= '0' && exp[i] <= '9')) {
                val = val + (exp[i] - '0') * base;
                base *= 10;
                i--;
            }
            i++; 
            push(val);
        } else {
            int val1 = pop();
            int val2 = pop();
            push(applyOp(val1, val2, exp[i]));
        }
    }
    return pop();
}

int main() {
    char expression[MAX];

    printf("Enter prefix expression (use spaces between numbers): ");
    fgets(expression, MAX, stdin);

    int result = evaluatePrefix(expression);
    printf("Result: %d\n", result);

    return 0;
}
